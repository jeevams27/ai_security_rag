# OpenRouter (LLM reasoning layer)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_MODEL=openai/gpt-4o-mini

# Embeddings (retrieval layer): local sentence-transformers model, downloaded once
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
TOP_K=8

# Vector store
CHROMA_DIR=.chroma
COLLECTION_NAME=code_units
